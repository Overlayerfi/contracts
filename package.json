{
  "name": "contract",
  "version": "1.0.0",
  "description": "Overlayer smart contracts",
  "scripts": {
    "unit": "npx hardhat test",
    "check-publish-age": "node check-dependency-publish-age.mjs",
    "configure": "git submodule update --init --recursive && bash setup.sh",
    "compile": "npx hardhat compile",
    "docgen": "npx hardhat docgen",
    "fix-docs": "./scripts/fix-docs.sh",
    "docs": "npm run docgen && npm run fix-docs",
    "node": "npx hardhat node",
    "exec-ova": "npx hardhat --network ova run",
    "exec-eth-sepolia": "npx hardhat --network eth_sepolia run",
    "exec-postconfigure-sepolia-oft-omnichain": "npx hardhat --network eth_sepolia run scripts/utils/postConfigureSepoliaOftFromOmnichainDeployments.ts",
    "exec-arb-sepolia": "npx hardhat --network arb_sepolia run",
    "exec-eth": "npx hardhat --network eth run",
    "exec-local": "npx hardhat --network localhost run",
    "prettier-sol": "prettier --write --plugin=prettier-plugin-solidity 'contracts/**/*.sol'",
    "prettier-check-sol": "prettier --check --plugin=prettier-plugin-solidity 'contracts/**/*.sol'",
    "prettier-ts": "prettier --config .prettierrc 'test/**/*.ts' --write &&  prettier --config .prettierrc 'scripts/**/*.ts' --write",
    "prettier-check-ts": "prettier --config .prettierrc 'test/**/*.ts' --check &&  prettier --config .prettierrc 'scripts/**/*.ts' --check"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.0.0",
    "@nomicfoundation/hardhat-ethers": "^3.0.0",
    "@nomicfoundation/hardhat-ignition-ethers": "^0.15.0",
    "@nomicfoundation/hardhat-network-helpers": "^1.0.0",
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@nomicfoundation/hardhat-verify": "^2.0.13",
    "@typechain/ethers-v6": "^0.5.0",
    "@typechain/hardhat": "^9.0.0",
    "@types/chai": "^4.2.0",
    "@types/mocha": "^10.0.0",
    "chai": "^4.2.0",
    "ethers": "^6.4.0",
    "hardhat": "^2.22.14",
    "hardhat-ethernal": "^3.3.0",
    "hardhat-gas-reporter": "^1.0.8",
    "prettier": "^2.8.8",
    "prettier-plugin-solidity": "^1.3.1",
    "solhint": "^3.4.1",
    "solidity-coverage": "^0.8.1",
    "solidity-docgen": "^0.6.0-beta.36",
    "ts-node": "^10.9.2",
    "typechain": "^8.3.0",
    "typescript": "~5.4.5"
  },
  "dependencies": {
    "@aave/core-v3": "^1.19.3",
    "@chainlink/contracts": "^1.3.0",
    "@ethersproject/address": "^5.7.0",
    "@layerzerolabs/lz-definitions": "^3.0.125",
    "@layerzerolabs/oft-evm": "^3.2.0",
    "@openzeppelin/contracts": "^5.0.2",
    "@types/big.js": "^6.2.2",
    "@types/node": "^18.11.2",
    "@uniswap/sdk-core": "^5.3.1",
    "@uniswap/v3-sdk": "^3.17.1",
    "big.js": "^5.2.1",
    "dotenv": "^16.0.3"
  },
  "overrides": {
    "eth-gas-reporter": {
      "axios": "1.15.2"
    }
  },
  "license": "GPL-3.0-only"
}
